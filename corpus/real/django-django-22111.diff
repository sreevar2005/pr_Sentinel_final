diff --git a/docs/_utils.py b/docs/_utils.py
new file mode 100644
index 000000000000..fea47a4191ba
--- /dev/null
+++ b/docs/_utils.py
@@ -0,0 +1,23 @@
+import tempfile
+
+from sphinx.application import Sphinx
+
+
+def find_sphinx_sources(srcdir):
+    # Use a minimal Sphinx app to locate source files per conf.py.
+    with tempfile.TemporaryDirectory() as tmpdir:
+        app = Sphinx(
+            srcdir=srcdir,
+            confdir=srcdir,
+            outdir=tmpdir,
+            doctreedir=tmpdir,
+            buildername="dummy",
+            # Disable extensions: none of them affect source discovery, and
+            # loading them would download intersphinx inventories.
+            confoverrides={"extensions": []},
+            status=None,
+        )
+        return [
+            str(app.project.doc2path(docname, absolute=True))
+            for docname in app.project.docnames
+        ]
diff --git a/docs/blacken-sources.py b/docs/blacken-sources.py
new file mode 100644
index 000000000000..1610a3f2f697
--- /dev/null
+++ b/docs/blacken-sources.py
@@ -0,0 +1,15 @@
+import sys
+from os.path import abspath, dirname
+
+from _utils import find_sphinx_sources
+from blacken_docs import main
+
+if __name__ == "__main__":
+    directory = dirname(abspath(__file__))
+    params = sys.argv[1:] if len(sys.argv) > 1 else []
+
+    source_files = find_sphinx_sources(directory)
+    print(f"Running blacken-docs on {len(source_files)} source files...")
+
+    args = ["--rst-literal-blocks", *params, *source_files]
+    sys.exit(main(args))
